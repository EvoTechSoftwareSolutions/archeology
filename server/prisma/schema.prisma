generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Province {
  id          Int      @id @default(autoincrement())
  name        String  @unique
  regionCode  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  districts   District[]
}

model District {
  id          Int      @id @default(autoincrement())
  name        String

  provinceId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  historicalPlaces HistoricalPlace[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HistoricalPlace {

  id          Int @id @default(autoincrement())

  name        String
  category    String
  description String?
  image       String?

  century     String
  statusFlag  String

  latitude    Float
  longitude   Float

  anchorXPct  Float
  anchorYPct  Float

  districtId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  district District @relation(fields:[districtId], references:[id], onDelete:Cascade)
    
   
   siteMonograph SiteMonograph[]
  auditLog AuditLog []

}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  status    String   @default("unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMonograph {
  id                  Int      @id @default(autoincrement())

  name                String

  historicalPlaceId   Int


  contentBody         String

  inscriptionIndex    String

  lastUpdated         DateTime

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  historicalPlace HistoricalPlace @relation(fields: [historicalPlaceId], references: [id], onDelete: Cascade)
  verifiedById        Int?
  verifiedBy          User?           @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
}

model AuditLog {
  id              Int      @id @default(autoincrement())


  targetPlaceId   Int

  actionType      String

  timestamp       DateTime @default(now())

  createdAt       DateTime @default(now())

  // Relations

  historicalPlace HistoricalPlace @relation(fields: [targetPlaceId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  department String
  role       String   @default("USER")

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  auditLogs       AuditLog[]
  verifiedSites   SiteMonograph[]
}

model Review {
  id          Int      @id @default(autoincrement())
  reviewerName String
  reviewerRole String?
  image       String?
  rating      Int      @default(5)
  reviewText  String   @db.Text
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}