generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Province {
  id          Int      @id @default(autoincrement())
  name        String  @unique
  regionCode  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  districts   District[]
}

model District {
  id          Int      @id @default(autoincrement())
  name        String

  provinceId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  historicalPlaces HistoricalPlace[]
}

model HistoricalPlace {

  id          Int @id @default(autoincrement())

  name        String
  category    String
  description String?
  image       String?

  century     String
  statusFlag  String

  latitude    Float
  longitude   Float

  anchorXPct  Float
  anchorYPct  Float

  districtId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  district District @relation(fields:[districtId], references:[id], onDelete:Cascade)
    
   
   siteMonograph SiteMonograph[]
  auditLog AuditLog []

}

model SiteMonograph {
  id                  Int      @id @default(autoincrement())

  name                String

  historicalPlaceId   Int


  contentBody         String

  inscriptionIndex    String

  lastUpdated         DateTime

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  historicalPlace HistoricalPlace @relation(fields: [historicalPlaceId], references: [id], onDelete: Cascade)

}

model AuditLog {
  id              Int      @id @default(autoincrement())


  targetPlaceId   Int

  actionType      String

  timestamp       DateTime @default(now())

  createdAt       DateTime @default(now())

  // Relations

  historicalPlace HistoricalPlace @relation(fields: [targetPlaceId], references: [id], onDelete: Cascade)
}