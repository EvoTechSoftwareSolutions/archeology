generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Province {
  id          Int      @id @default(autoincrement())
  name        String  @unique
  regionCode  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  districts   District[]
  historicalPlaces HistoricalPlace[]
}

model District {
  id          Int      @id @default(autoincrement())
  name        String

  provinceId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  historicalPlaces HistoricalPlace[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------
// Extended HistoricalPlace model, adding the fields your Add New Place
// form now collects: gallery images, nearby facilities, travel tips, and
// SEO fields. Everything from your original model is preserved.
//
// Your District/Province models, SiteMonograph, and AuditLog are
// untouched — only shown here as relation targets for context.
// -----------------------------------------------------------------------

model HistoricalPlace {
  id          Int     @id @default(autoincrement())

  name        String
  category    String
  description String?
  image       String? // hero image

  

  century     String
  statusFlag  String

  latitude    Float
  longitude   Float

  anchorXPct  Float
  anchorYPct  Float
  provinceId   Int?
  province     Province? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  districtId  Int?
  district    District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  // --- NEW: facilities & travel --------------------------------------
  nearbyHotels     String?
  nearbyHospitals  String?
  nearbyRestaurant String?
  travelTips       String?

  // --- NEW: Dynamic Place Details -------------------------------------
  timelineJson          String?   @db.Text
  crowd                 String?
  distance              String?
  drivingTime           String?
  walkingTime           String?
  recommendedDeparture  String?
  weather               String?
  temperature           String?
  photographyTime       String?
  nearbyFuel            String?
  nearbyWashrooms       String?
  nearbyBusStops        String?
  nearbyParking         String?
  nearbyRailway         String?
  emergencyPolice       String?
  emergencyAmbulance     String?
  openingHours          String?
  earlyMorningSlot      String?
  midDaySlot            String?
  lateAfternoonSlot     String?
  visitNote             String?   @db.Text
  contactAddress        String?
  contactAdminPhone     String?
  contactEmergencyPhone String?
  contactWebsite        String?
  contactEmail          String?
  dressCode             String?   @db.Text
  photographyRules      String?   @db.Text
  accessibility         String?   @db.Text
  dosJson               String?   @db.Text
  dontsJson             String?   @db.Text

  // --- NEW: SEO --------------------------------------------------------
  seoTitle        String?
  metaDescription String?
  slug            String? @unique
  focusKeywords   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  galleryImages PlaceGalleryImage[]
  siteMonograph SiteMonograph[]
  auditLog      AuditLog[]
}

model PlaceGalleryImage {
  id                Int             @id @default(autoincrement())
  url               String
  position          Int             @default(0)
  historicalPlaceId Int
  historicalPlace   HistoricalPlace @relation(fields: [historicalPlaceId], references: [id], onDelete: Cascade)
}


model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?  // Added optional phone number field
  subject     String?
  message     String   @db.Text
  status      String   @default("unread")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteMonograph {
  id                  Int      @id @default(autoincrement())

  name                String

  historicalPlaceId   Int


  contentBody         String

  inscriptionIndex    String

  lastUpdated         DateTime

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  historicalPlace HistoricalPlace @relation(fields: [historicalPlaceId], references: [id], onDelete: Cascade)
  verifiedById        Int?
  verifiedBy          User?           @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
}

model AuditLog {
  id              Int      @id @default(autoincrement())


  targetPlaceId   Int

  actionType      String

  timestamp       DateTime @default(now())

  createdAt       DateTime @default(now())

  // Relations

  historicalPlace HistoricalPlace @relation(fields: [targetPlaceId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  department String

  role       UserRole @default(USER)

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  auditLogs       AuditLog[]
  verifiedSites   SiteMonograph[]
}


enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model Review {
  id          Int      @id @default(autoincrement())
  reviewerName String
  reviewerRole String?
  image       String?
  rating      Int      @default(5)
  reviewText  String   @db.Text
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}