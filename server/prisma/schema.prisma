generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  department String
  role       String   @default("USER")

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  auditLogs       AuditLog[]
  verifiedSites   SiteMonograph[]
}

model Province {
  id          Int      @id @default(autoincrement())
  name        String  @unique
  regionCode  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  districts   District[]
}

model District {
  id          Int      @id @default(autoincrement())
  name        String

  provinceId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  historicalPlaces HistoricalPlace[]
}

model HistoricalPlace {
  id          Int      @id @default(autoincrement())

  name        String
  category    String
  statusFlag  String
  century     String

  latitude    Float
  longitude   Float

  districtId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  district        District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  monographs      SiteMonograph[]
  auditLogs       AuditLog[]
}

model SiteMonograph {
  id                  Int      @id @default(autoincrement())

  name                String

  historicalPlaceId   Int

  verifiedById        Int

  contentBody         String

  inscriptionIndex    String

  lastUpdated         DateTime

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  historicalPlace HistoricalPlace @relation(fields: [historicalPlaceId], references: [id], onDelete: Cascade)

  verifiedBy User @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
}

model AuditLog {
  id              Int      @id @default(autoincrement())

  userId          Int

  targetPlaceId   Int

  actionType      String

  timestamp       DateTime @default(now())

  createdAt       DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  historicalPlace HistoricalPlace @relation(fields: [targetPlaceId], references: [id], onDelete: Cascade)
}